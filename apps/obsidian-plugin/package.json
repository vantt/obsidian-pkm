{
  "name": "pkm-obsidian-plugin",
  "version": "0.1.0-rc.4",
  "private": true,
  "license": "UNLICENSED",
  "description": "Obsidian plugin for pkm: workshop pages, review log, table zoom, and a bridge to the pkm binary",
  "type": "module",
  "scripts": {
    "build": "node scripts/check-version.mjs && tsc --noEmit && node esbuild.config.mjs",
    "check-version": "node scripts/check-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:vault": "node e2e/vault.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "1.14.4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
